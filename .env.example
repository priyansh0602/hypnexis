# Copy this file to .env for local development. Never commit .env.
# Values used by the mobile app must use EXPO_PUBLIC_ and must be safe to expose.

# Public mobile configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Supabase's current key names; use these only if the dashboard does not show legacy keys.
# The publishable key is public; the secret key is server-side only.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never place these in apps/mobile or a mobile build.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Imagery providers (filled during Phase 3 after current API/licence verification)
MAPILLARY_ACCESS_TOKEN=
KARTAVIEW_API_BASE_URL=

# OSM/Nominatim identification. Use a real contact address before making requests.
OSM_NOMINATIM_USER_AGENT=AccessPath/0.1 (contact: replace-me@example.com)

# Local development defaults
ACCESSPATH_ENV=development
ACCESSPATH_PILOT_CONFIG=services/graph-builder/config/pilot.example.json
