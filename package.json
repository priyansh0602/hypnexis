{
  "name": "accesspath",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible, footpath-aware navigation for wheelchair users in India.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "test": "node --test tests/*.test.mjs && node --experimental-strip-types --test packages/shared/test/*.test.ts",
    "supabase:verify": "node supabase/scripts/verify-foundation.mjs",
    "supabase:test-fusion": "node supabase/scripts/test-fusion.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
