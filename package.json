{
  "name": "accesspath",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible, footpath-aware navigation for wheelchair users in India.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @accesspath/shared typecheck && pnpm --filter @accesspath/mobile typecheck",
    "test": "node --test tests/*.test.mjs"
  }
}
