{
  "expo": {
    "name": "AccessPath",
    "slug": "accesspath",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A1236",
      "resizeMode": "contain"
    },
    "scheme": "accesspath",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.accesspath.mobile"
    },
    "android": {
      "package": "com.accesspath.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A1236"
      },
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    }
  }
}
